# Domínio público (precisa de HTTPS: PWA, wake lock e cookie de sessão dependem disso)
FITTRACK_DOMAIN=treino.exemplo.com

# Hash da senha de acesso. Gere com: npm run hash-password -- "sua-senha"
APP_PASSWORD_HASH=

# Backups diários do SQLite (03:30, America/Sao_Paulo)
BACKUP_HOST_DIR=/opt/fittrack-backups
BACKUP_RETENTION_DAYS=14

# Só para rodar fora do Docker
# PORT=3000
# DATABASE_PATH=./data/fittrack.db
# BACKUP_PATH=./data/backups
